# 依赖目录（核心：必须忽略）
node_modules/
backend/target/
backend/build/
!backend/src/main/war/?  # 如果使用 war 打包，有时需要保留一些目录，但通常忽略 target 即可

# 构建产物
dist/
backend/out/
*.class
*.jar
*.war
*.ear

# IDE 配置文件（可选，建议忽略）
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.factorypath

# 系统文件
.DS_Store
Thumbs.db
*.log
*.pid
*.seed
*.pid.lock

# 日志文件
logs/
*.log

# 环境变量配置文件（如果包含敏感信息）
.env
.env.local
.env.*.local

# Spring Boot 相关
backend/target/
backend/!src/main/resources/application.properties  # 如果希望保留默认配置文件，可以排除，但通常不这样写
backend/!src/main/resources/application.yml
# 注意：上面两行写法是取反，表示不忽略这些文件，但如果你不确定，直接忽略整个 target 即可

# 前端构建临时文件
.vite/